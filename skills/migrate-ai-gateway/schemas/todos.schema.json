{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/ai-gateway/migration/todos.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {"const": "4.0"},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "mappingIds", "capabilityId", "target", "arguments", "desiredState", "dependsOn", "precondition", "approval", "status", "attempts", "behaviorResults"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mappingIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "capabilityId": {"type": "string"},
          "target": {
            "type": "object", "additionalProperties": false,
            "required": ["subscription", "resourceGroup", "gateway", "workspace", "name", "provider"],
            "properties": {
              "subscription": {"type": "string", "minLength": 1},
              "resourceGroup": {"type": "string", "minLength": 1},
              "gateway": {"type": "string", "minLength": 1},
              "workspace": {"const": "default", "description": "Internal target scope; the CLI selects default without a --workspace-name argument."},
              "name": {"type": ["string", "null"]},
              "provider": {"type": ["string", "null"]}
            }
          },
          "arguments": {"type": "object"},
          "desiredState": {"type": "object", "minProperties": 1},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "resourceDependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "precondition": {
            "type": "object", "additionalProperties": false, "required": ["exists", "stateDigest"],
            "properties": {"exists": {"type": "boolean"}, "stateDigest": {"type": ["string", "null"]}}
          },
          "approval": {
            "type": "object", "additionalProperties": false, "required": ["status", "planDigest", "approvedAt"],
            "properties": {
              "status": {"enum": ["pending", "approved", "invalidated", "rejected"]},
              "planDigest": {"type": ["string", "null"]},
              "approvedAt": {"type": ["string", "null"]}
            }
          },
          "status": {"enum": ["pending", "in-progress", "mutation-unknown", "resource-verified", "behavior-verified", "blocked", "failed"]},
          "attempts": {"type": "array", "items": {"type": "object"}},
          "behaviorResults": {
            "type": "object",
            "additionalProperties": {
              "type": "object", "additionalProperties": false,
              "required": ["status", "method", "evidenceDigest", "recordedAt"],
              "properties": {
                "status": {"enum": ["pending", "passed", "failed", "inconclusive"]},
                "method": {"enum": ["control-plane", "data-plane", "administrator-attestation"]},
                "evidenceDigest": {"type": ["string", "null"]},
                "recordedAt": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
