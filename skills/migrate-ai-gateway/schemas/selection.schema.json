{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/ai-gateway/migration/selection.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "catalogDigest", "providers", "models", "mcp", "keys", "retained", "gateway"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "catalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gateway": {"type": "object", "additionalProperties": false,
      "properties": {"location": {"type": "string"}, "subnet": {"type": "string"},
        "sku": {"enum": ["Standard", "Premium", "Consumption"]}}},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}},
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
    "mcp": {"type": "array", "items": {"$ref": "#/$defs/mcp"}},
    "keys": {"type": "array", "items": {"$ref": "#/$defs/key"}},
    "policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}},
    "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
    "network": {"$ref": "#/$defs/network"},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "telemetry": {"type": "array", "items": {"$ref": "#/$defs/telemetry"}},
    "retained": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["sourceId", "reason"], "properties": {
        "sourceId": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "provider": {"type": "object", "additionalProperties": false,
      "required": ["id", "settings", "sourceIds", "evidence"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "settings": {"type": "object"},
        "sourceIds": {"$ref": "#/$defs/sourceIds"}, "evidence": {"type": "string", "minLength": 1},
        "reuseExisting": {"type": "boolean"}}},
    "model": {"type": "object", "additionalProperties": false,
      "required": ["provider", "id", "name", "apiFormat", "endpoints", "sourceIds", "evidence"],
      "allOf": [{"if": {"required": ["explicitAlias"], "properties": {"explicitAlias": {"const": true}}},
        "then": {}, "else": {"required": ["alias", "routingName"]}}],
      "properties": {
        "provider": {"type": "string"}, "id": {"type": "string"},
        "name": {"type": "string"}, "alias": {"type": "string"}, "routingName": {"type": "string"},
        "apiFormat": {"type": "string"}, "endpoints": {"type": "array", "minItems": 1,
          "uniqueItems": true, "items": {"type": "string"}},
        "sourceIds": {"$ref": "#/$defs/sourceIds"}, "evidence": {"type": "string", "minLength": 1},
        "updateAlias": {"type": "boolean"}, "explicitAlias": {"type": "boolean"}
      }},
    "mcp": {"type": "object", "additionalProperties": false,
      "required": ["name", "endpoints", "sourceIds", "evidence", "accessDecision"],
      "properties": {"name": {"type": "string"}, "endpoints": {"type": "array", "minItems": 1},
        "sourceIds": {"$ref": "#/$defs/sourceIds"}, "evidence": {"type": "string", "minLength": 1},
        "accessDecision": {"type": "string", "minLength": 1},
        "reuseExisting": {"type": "boolean"}, "replaceEndpoints": {"type": "boolean"},
        "versions": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
        "credentialUseApproved": {"const": true}}},
    "key": {"type": "object", "additionalProperties": false,
      "required": ["name", "displayName", "sourceIds", "accessDecision"],
      "properties": {"name": {"type": "string"}, "displayName": {"type": "string", "minLength": 1},
        "sourceIds": {"$ref": "#/$defs/sourceIds"}, "accessDecision": {"type": "string", "minLength": 1},
        "state": {"enum": ["active", "suspended"]}, "expirationDate": {"type": "string", "format": "date-time"},
        "updateExisting": {"type": "boolean"}}},
    "binding": {"type": "object", "required": ["sourceIds", "behaviorIds", "evidence", "scopeDecision"],
      "properties": {"sourceIds": {"$ref": "#/$defs/sourceIds"},
        "behaviorIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "evidence": {"type": "string", "minLength": 1}, "scopeDecision": {"type": "string", "minLength": 1},
        "translationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "policy": {"allOf": [{"$ref": "#/$defs/binding"}], "type": "object", "unevaluatedProperties": false,
      "required": ["scope", "settings"],
      "properties": {"scope": {"enum": ["workspace", "model"]}, "model": {"type": "string"},
        "provider": {"type": "string"}, "settings": {"type": "object"},
        "newGovernance": {"const": true}}},
    "alias": {"type": "object", "additionalProperties": false,
      "required": ["name", "routingName", "backends", "sourceIds", "evidence", "scopeDecision"],
      "properties": {"name": {"type": "string"}, "routingName": {"type": "string"},
        "sourceIds": {"$ref": "#/$defs/sourceIds"}, "evidence": {"type": "string", "minLength": 1},
        "sourcePoolId": {"type": "string", "minLength": 1},
        "scopeDecision": {"type": "string", "minLength": 1}, "updateExisting": {"type": "boolean"},
        "backends": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true,
          "items": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "priority", "weight"],
            "properties": {"provider": {"type": "string"}, "model": {"type": "string"},
              "sourceBackendId": {"type": "string", "minLength": 1},
              "priority": {"type": "integer", "minimum": 0, "maximum": 100},
              "weight": {"type": "integer", "minimum": 1, "maximum": 100}}}}}},
    "network": {"allOf": [{"$ref": "#/$defs/binding"}], "type": "object", "unevaluatedProperties": false,
      "required": ["settings", "verificationAccess"], "properties": {"settings": {"type": "object"},
        "verificationAccess": {"type": "string", "minLength": 1}}},
    "connection": {"allOf": [{"$ref": "#/$defs/binding"}], "type": "object", "unevaluatedProperties": false,
      "required": ["name", "peerId", "description"], "properties": {"name": {"type": "string"},
        "peerId": {"type": "string"}, "description": {"type": "string", "minLength": 1}}},
    "telemetry": {"allOf": [{"$ref": "#/$defs/binding"}], "type": "object", "unevaluatedProperties": false,
      "required": ["name", "settings"], "properties": {"name": {"type": "string"},
        "settings": {"type": "object"}, "reuseExisting": {"type": "boolean"},
        "updateExisting": {"type": "boolean"}}}
  }
}
