{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/aigateway/tools/migrate-apim/schemas/inventory.schema.json",
  "title": "APIM AI inventory",
  "description": "A faithful, secret-free capture of the AI assets of an Azure API Management instance, decomposed the way Azure AI Gateway building blocks are shaped.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "generator",
    "collection",
    "service",
    "apim",
    "assets",
    "excludedApis",
    "secrets"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "apimAiInventory"},
    "generator": {
      "type": "object",
      "required": ["name", "version", "command"],
      "properties": {
        "name": {"const": "migrate-apim"},
        "version": {"type": "string"},
        "command": {"type": "string"}
      }
    },
    "collection": {
      "type": "object",
      "required": ["startedAt", "completedAt", "apiVersions", "options", "coverage", "warnings"],
      "properties": {
        "startedAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": "string", "format": "date-time"},
        "requestCount": {"type": "integer", "minimum": 0},
        "apiVersions": {
          "type": "object",
          "properties": {"apiManagement": {"type": "string"}, "cognitiveServices": {"type": ["string", "null"]}}
        },
        "options": {"type": "object"},
        "coverage": {
          "description": "One record per control-plane collection read, so completeness is provable rather than assumed.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["collection", "scope", "status", "count", "error"],
            "properties": {
              "collection": {"type": "string"},
              "scope": {"type": "string"},
              "status": {
                "description": "notCollected means the read was deliberately skipped; it is not evidence that nothing is there.",
                "enum": ["complete", "empty", "notFound", "failed", "notCollected"]
              },
              "count": {"type": "integer", "minimum": 0},
              "error": {"type": ["string", "null"]}
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code"],
            "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["resourceId", "name", "sku"],
      "properties": {
        "resourceId": {"type": "string"},
        "name": {"type": "string"},
        "location": {"type": ["string", "null"]},
        "subscriptionId": {"type": "string"},
        "resourceGroup": {"type": ["string", "null"]},
        "sku": {"type": ["object", "null"]},
        "gatewayUrl": {"type": ["string", "null"]},
        "virtualNetworkType": {"type": ["string", "null"]},
        "publicNetworkAccess": {"type": ["string", "null"]},
        "hostnameConfigurations": {"type": "array"},
        "identity": {
          "description": "The service's managed identities. `userAssignedIdentities` decides whether the gateway can carry one over with the grants it already holds, or needs a new principal granted from scratch.",
          "type": ["object", "null"],
          "properties": {
            "type": {"type": ["string", "null"]},
            "principalId": {"type": ["string", "null"]},
            "tenantId": {"type": ["string", "null"]},
            "userAssignedIdentities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {"resourceId": {"type": "string"}, "clientId": {"type": ["string", "null"]}}
              }
            }
          }
        },
        "networking": {
          "description": "How the service reaches its backends and is reached. `targetRequirement` is the collector's reading of what the gateway would have to do to match it; null when nothing private is in play.",
          "type": ["object", "null"],
          "properties": {
            "virtualNetworkType": {"type": ["string", "null"]},
            "publicNetworkAccess": {"type": ["string", "null"]},
            "vnetId": {"type": ["string", "null"]},
            "vnetIntegrated": {"type": "boolean"},
            "subnetResourceId": {"type": ["string", "null"]},
            "natGatewayState": {"type": ["string", "null"]},
            "outboundPublicIPAddresses": {"type": ["array", "null"]},
            "privateEndpointConnections": {"type": ["array", "null"]},
            "targetRequirement": {
              "type": ["object", "null"],
              "properties": {"needsSubnet": {"type": "boolean"}, "note": {"type": "string"}}
            }
          }
        },
        "tags": {"type": "object"},
        "needsSubnet": {
          "description": "Whether the target needs a delegated subnet to reach backends the way the source does. Worked out from `virtualNetworkType` and `publicNetworkAccess`; what it is about is the service.",
          "type": ["boolean", "null"]
        }
      }
    },
    "assets": {
      "type": "object",
      "required": ["modelProviders", "models", "mcpServers", "agents"],
      "properties": {
        "modelProviders": {"type": "array", "items": {"$ref": "#/$defs/modelProvider"}},
        "models": {"type": "array", "items": {"$ref": "#/$defs/modelApi"}},
        "mcpServers": {"type": "array", "items": {"$ref": "#/$defs/mcpServer"}},
        "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}}
      }
    },
    "apim": {
      "description": "What APIM has, named as APIM names it. `assets` is what this tool concluded about it; this is the source side of that reading, so a question about the service rather than about the migration is answered here.",
      "type": "object",
      "required": ["workspaces", "apis", "policies"],
      "properties": {
        "apis": {
          "description": "Every API on the service, inventoried or not. The union of three asset families and `excludedApis` used to be the only way to ask what APIs exist, with model providers in a fourth list that has no API behind it at all. The fields are the same `_api_source` builds for each asset's `source` block, from the same function, so the two cannot disagree.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["apiId", "name", "workspace", "type", "role", "assetId", "excludedReason"],
            "properties": {
              "apiId": {"type": "string"},
              "name": {"type": ["string", "null"]},
              "workspace": {"type": "string"},
              "resourceId": {"type": ["string", "null"]},
              "displayName": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "type": {
                "description": "APIM's own discriminator: http, mcp, a2a, unifiedModelApi.",
                "type": "string"
              },
              "path": {"type": ["string", "null"]},
              "effectivePath": {"type": ["string", "null"]},
              "protocols": {"type": ["array", "null"], "items": {"type": "string"}},
              "serviceUrl": {"type": ["string", "null"]},
              "backendId": {"type": ["string", "null"]},
              "apiRevision": {"type": ["string", "null"]},
              "apiVersion": {"type": ["string", "null"]},
              "apiVersionSetId": {"type": ["string", "null"]},
              "isCurrent": {"type": ["boolean", "null"]},
              "accessState": {"type": ["string", "null"]},
              "subscriptionRequired": {"type": ["boolean", "null"]},
              "assetId": {
                "description": "The asset this API became, or null. Exactly one of this and `excludedReason` is set.",
                "type": ["string", "null"]
              },
              "excludedReason": {"description": "Why it became no asset, or null.", "type": ["string", "null"]},
              "role": {
                "description": "What this tool made of the API. APIM's `type` says mcp or a2a outright; an http-typed API can still be a model API and APIM has no field that says so.",
                "enum": ["modelApi", "mcpServer", "agent", "excluded"]
              },
              "pattern": {"type": ["string", "null"]},
              "operations": {
                "description": "APIM's operations for this API, each with two readings of its urlTemplate named as readings: `group` is which inference route it looks like, `publishable` whether the target publishes that route.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "displayName": {"type": ["string", "null"]},
                    "method": {"type": ["string", "null"]},
                    "urlTemplate": {"type": "string"},
                    "description": {"type": ["string", "null"]},
                    "policyId": {"type": ["string", "null"]},
                    "group": {"type": "string"},
                    "publishable": {
                      "description": "Whether the target publishes this route. Null for a wildcard, where it genuinely cannot be read -- which is not the same as false, and is why the two surface rules do not overlap.",
                      "type": ["boolean", "null"]
                    },
                    "route": {"type": ["string", "null"]},
                    "subresource": {"type": ["boolean", "null"]},
                    "template": {"type": ["string", "null"]}
                  }
                }
              },
              "discoverySource": {"type": ["string", "null"]},
              "translation": {"type": ["string", "null"]},
              "toolDiscovery": {"type": ["string", "null"]},
              "toolsFromGateway": {"type": ["boolean", "null"]},
              "catalogueFetched": {
                "description": "Whether a model catalogue was actually fetched for this API. The fetch is this tool's -- CognitiveServices deployments, a backend declaration, a /v1/models call -- but what it is about is the API.",
                "type": ["boolean", "null"]
              }
            }
          }
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "collected"],
            "properties": {
              "name": {"type": "string"},
              "displayName": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "serveOn": {"type": ["string", "null"]},
              "collected": {"type": "boolean"}
            }
          }
        },
        "backends": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "pool": {
                "type": ["object", "null"],
                "properties": {
                  "services": {"type": "array"},
                  "failureResponse": {"type": ["object", "null"]},
                  "sessionAffinity": {"type": ["object", "string", "null"]}
                }
              }
            }
          }
        },
        "namedValues": {"type": "array", "items": {"$ref": "#/$defs/namedValue"}},
        "products": {"type": "array"},
        "subscriptions": {"type": "array"},
        "certificates": {"type": "array"},
        "authorizationServers": {"type": "array"},
        "openidConnectProviders": {"type": "array"},
        "policyFragments": {"type": "array"},
        "authorizationProviders": {
          "description": "APIM's own name for the resource; this inventory used to call it `credentialProviders`, which is a name APIM does not use.",
          "type": "array"
        },
        "loggers": {
          "description": "APIM has loggers and diagnostics; `telemetry` was a box this tool put them in, and a rule had to select the box to reach either.",
          "type": "array"
        },
        "diagnostics": {"type": "array"},
        "policies": {"type": "array", "items": {"$ref": "#/$defs/policyDocument"}}
      }
    },
    "excludedApis": {
      "description": "Every API the collector saw and did not inventory, with the reason. Nothing is dropped silently.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["apiId", "name", "type", "reason"],
        "properties": {
          "apiId": {"type": "string"},
          "name": {"type": ["string", "null"]},
          "displayName": {"type": ["string", "null"]},
          "type": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "reason": {"type": "string"},
          "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
          "referencedBy": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "excludedBackends": {
      "description": "Backends the collector did not treat as model providers, with the reason. Proves backend coverage the way excludedApis proves API coverage.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backendId", "name", "reason"],
        "properties": {
          "backendId": {"type": "string"},
          "name": {"type": "string"},
          "url": {"type": ["string", "null"]},
          "host": {"type": ["string", "null"]},
          "reason": {"type": "string"},
          "usedByAssets": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "secrets": {"type": "array", "items": {"$ref": "#/$defs/secretRef"}},
    "foundryAccounts": {
      "description": "Not APIM: Microsoft.CognitiveServices accounts, read to resolve what a Foundry backend serves.",
      "type": "array"
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "required": ["type", "value", "weight"],
      "properties": {
        "type": {"type": "string"},
        "value": {"type": "string"},
        "weight": {"type": "integer"},
        "detail": {"type": "string"}
      }
    },
    "detection": {
      "type": "object",
      "required": ["confidence", "score", "signals"],
      "properties": {
        "confidence": {"enum": ["high", "medium", "low", "forced", "none"]},
        "score": {"type": "integer"},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
        "providerGuess": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "apiSource": {
      "type": "object",
      "required": ["apiId", "name", "type", "path"],
      "properties": {
        "apiId": {"type": "string"},
        "name": {"type": ["string", "null"]},
        "resourceId": {"type": ["string", "null"]},
        "displayName": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "type": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "protocols": {"type": ["array", "null"]},
        "serviceUrl": {"type": ["string", "null"]},
        "backendId": {"type": ["string", "null"]},
        "apiRevision": {"type": ["string", "null"]},
        "isCurrent": {"type": ["boolean", "null"]}
      }
    },
    "modelProvider": {
      "description": "An upstream model endpoint. Maps to an AI Gateway modelProvider, and exists even when no APIM API publishes it.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "providerKind",
        "targetProviderKind",
        "endpoint",
        "origin",
        "auth",
        "models",
        "referencedBy"
      ],
      "properties": {
        "id": {"type": "string"},
        "kind": {"const": "modelProvider"},
        "workspace": {"type": "string"},
        "providerKind": {"type": "string"},
        "providerLabel": {"type": ["string", "null"]},
        "targetProviderKind": {"enum": ["Foundry", "Custom"]},
        "apiDialect": {"type": ["string", "null"]},
        "endpoint": {"type": ["string", "null"]},
        "origin": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["backend", "serviceUrl"]},
            "backendId": {"type": "string"},
            "backendName": {"type": "string"},
            "apiId": {"type": "string"}
          }
        },
        "auth": {"$ref": "#/$defs/auth"},
        "azure": {"type": ["object", "null"]},
        "models": {"$ref": "#/$defs/modelCatalogue"},
        "referencedBy": {
          "type": "object",
          "properties": {"apis": {"type": "array", "items": {"type": "string"}}, "policies": {"type": "array"}}
        },
        "secretRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "modelCatalogue": {
      "type": "object",
      "required": ["status", "discoverySource", "resolved"],
      "properties": {
        "status": {
          "description": "catalogued is what `migrate-apim resolve` writes after reading a provider's own catalogue: the models exist, but the response states no modality, so which of them can serve an inference route is still a decision. It was missing here while `resolve.py` wrote it and `plan.py` branched on it, so validating a resolved inventory failed on a value the tool had just produced -- the same hole `auth.mode: undetermined` left.",
          "enum": ["resolved", "declared", "unresolved", "empty", "catalogued"]
        },
        "resolvedFrom": {
          "description": "The catalogue endpoint the models were read from. Null until a resolve run writes one.",
          "type": ["string", "null"]
        },
        "catalogue": {
          "description": "The model names the catalogue returned, which the planner samples into the question it asks.",
          "type": "array",
          "items": {"type": "string"}
        },
        "discoverySource": {
          "enum": [
            "armDeployments",
            "backendLanguageModel",
            "modelsEndpoint",
            "awsCli",
            "gcloudCli",
            "manual",
            "unknown"
          ]
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deploymentName": {"type": ["string", "null"]},
              "modelName": {"type": ["string", "null"]},
              "modelVersion": {"type": ["string", "null"]},
              "modelFormat": {"type": ["string", "null"]},
              "sku": {"type": ["object", "null"]},
              "target": {"description": "Pre-shaped AI Gateway model registration input.", "type": "object"}
            }
          }
        },
        "declared": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "auth": {
      "type": "object",
      "required": ["mode", "secretRefs"],
      "properties": {
        "mode": {
          "description": "undetermined is not a mode the backend has; it says the question could not be answered -- a fragment that would not resolve, or no policy read at all. It is listed because the collector emits it, and a value the code produces and the schema rejects is a contract that only holds while nobody hits the case.",
          "enum": [
            "none",
            "apiKey",
            "authorizationHeader",
            "clientCertificate",
            "managedIdentity",
            "credentialManager",
            "undetermined"
          ]
        },
        "secretRefs": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "modes": {"type": "array", "items": {"type": "string"}},
        "parameters": {"type": "object"},
        "scheme": {"type": ["string", "null"]},
        "note": {"type": "string"},
        "identity": {"type": ["object", "null"]},
        "identityCandidates": {
          "description": "Set when alternative request contexts authenticate differently -- two products each setting their own managed identity, say. One provider cannot authenticate two ways, so the first is proposed and the rest are recorded rather than silently discarded.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"clientId": {"type": ["string", "null"]}, "audience": {"type": ["string", "null"]}}
          }
        },
        "identityNote": {"type": "string"},
        "basis": {"type": "object"}
      }
    },
    "modelApi": {
      "description": "An APIM API that publishes model inference. Maps to AI Gateway models plus an alias.",
      "type": "object",
      "required": ["id", "kind", "source", "detection", "provider", "routing", "models", "endpoints"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"const": "modelApi"},
        "workspace": {"type": "string"},
        "pattern": {"type": "string"},
        "source": {"$ref": "#/$defs/apiSource"},
        "detection": {"$ref": "#/$defs/detection"},
        "provider": {"type": "object"},
        "providerIds": {"type": "array", "items": {"type": "string"}},
        "routing": {
          "type": "object",
          "required": ["mode", "targets"],
          "properties": {
            "mode": {"enum": ["single", "pool", "policy"]},
            "targets": {"type": "array"},
            "circuitBreaker": {"type": ["array", "null"]},
            "sessionAffinity": {
              "description": "The APIM pool's session affinity, read verbatim. Null unless the pool pins a session to the backend that served it.",
              "type": ["object", "null"]
            },
            "evidence": {"type": ["string", "null"]}
          }
        },
        "models": {"$ref": "#/$defs/modelCatalogue"},
        "endpoints": {"$ref": "#/$defs/endpoints"},
        "policyRefs": {"$ref": "#/$defs/policyRefs"},
        "access": {"type": "object"}
      }
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "inboundDialects": {
          "description": "Inferred from operation URL templates, which operators configure freely. Evidence, not a declaration.",
          "type": "array",
          "items": {"type": "string"}
        },
        "inboundDialectsInferredFrom": {"const": "operationTemplates"},
        "backendDialects": {
          "description": "Declared by a languageModel backend's apiFormat.",
          "type": "array",
          "items": {"type": "string"}
        },
        "backendDialectsDeclared": {"type": "boolean"},
        "surface": {
          "description": "How much of what the API publishes can move. `unbounded` means a wildcard operation forwards every upstream path, so the exposed surface cannot be read from configuration at all -- which is not the same as publishing nothing.",
          "type": "object",
          "properties": {
            "status": {"enum": ["bounded", "unbounded", "unknown"]},
            "basis": {"type": "string"},
            "operationCount": {"type": "integer"},
            "publishable": {"type": "array"},
            "unpublishable": {"type": "array"},
            "publishableCount": {"type": "integer"},
            "unpublishableCount": {"type": "integer"},
            "targetRoutes": {"type": "array", "items": {"type": "string"}},
            "note": {"type": "string"}
          }
        },
        "translation": {
          "description": "Null only when the backend declares no dialect to compare against.",
          "oneOf": [
            {
              "type": "object",
              "required": ["status", "inbound", "backend", "basis", "note"],
              "properties": {
                "status": {
                  "description": "indeterminate means the operation templates carry no recognizable inference route, so a caller-side dialect could not be read from configuration.",
                  "enum": ["translating", "native", "indeterminate"]
                },
                "inbound": {"type": "array", "items": {"type": "string"}},
                "backend": {"type": "array", "items": {"type": "string"}},
                "basis": {"type": "object"},
                "note": {"type": "string"}
              }
            },
            {"type": "null"}
          ]
        },
        "operations": {"type": "array"},
        "basePath": {
          "description": "The API's configured path, read verbatim from APIM.",
          "type": ["string", "null"]
        }
      }
    },
    "mcpServer": {
      "description": "An APIM MCP API. Maps to an AI Gateway toolServer with one or more endpoints.",
      "type": "object",
      "required": ["id", "kind", "pattern", "source", "mcp", "tools", "toolDiscovery"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"const": "mcpServer"},
        "workspace": {"type": "string"},
        "pattern": {
          "description": "passthrough proxies an upstream MCP server; toolProjection exposes APIM operations as tools; federationRouter fans out to several; unconfigured has no upstream at all.",
          "enum": ["passthrough", "toolProjection", "federationRouter", "unconfigured"]
        },
        "source": {"$ref": "#/$defs/apiSource"},
        "detection": {"$ref": "#/$defs/detection"},
        "mcp": {"type": "object"},
        "upstream": {"type": "array"},
        "sourceApiIds": {"type": "array", "items": {"type": "string"}},
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "origin": {"enum": ["operation", "upstreamRuntime"]},
              "operationId": {"type": ["string", "null"]},
              "sourceApi": {"type": ["string", "null"]},
              "hasToolPolicy": {"type": "boolean"}
            }
          }
        },
        "toolCount": {"type": "integer"},
        "toolDiscovery": {
          "type": "object",
          "required": ["status", "source"],
          "properties": {
            "status": {"enum": ["complete", "runtimeOnly"]},
            "source": {"enum": ["apimControlPlane", "upstreamMcpServer", "gatewayRuntime", "upstreamRuntime"]},
            "url": {"type": ["string", "null"]},
            "policiesApplied": {
              "description": "Whether the API's policies ran while the tools were listed. False means the list came straight from the upstream and can be broader than what callers reach.",
              "type": "boolean"
            },
            "note": {"type": "string"},
            "discoveredCount": {"type": "integer"}
          }
        },
        "openApiSources": {"type": ["array", "null"]},
        "policyRefs": {"$ref": "#/$defs/policyRefs"},
        "access": {"type": "object"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "agent": {
      "description": "An APIM A2A agent API. Inventoried now; AI Gateway has no agent building block yet.",
      "type": "object",
      "required": ["id", "kind", "source", "agent", "agentCard", "hosting", "upstream", "a2a", "note"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"const": "agent"},
        "workspace": {"type": "string"},
        "pattern": {"const": "a2a"},
        "source": {"$ref": "#/$defs/apiSource"},
        "detection": {"$ref": "#/$defs/detection"},
        "agent": {
          "description": "The agent's identity as APIM records it.",
          "type": "object",
          "properties": {
            "id": {"type": ["string", "null"]},
            "name": {"type": ["string", "null"]},
            "providerName": {"type": ["string", "null"]},
            "managementPortalUrl": {"type": ["string", "null"]}
          }
        },
        "agentCard": {
          "description": "APIM stores the card's location, never its content.",
          "type": "object",
          "required": ["backendUrl", "exposedPath", "discovery"],
          "properties": {
            "backendUrl": {"type": ["string", "null"]},
            "exposedPath": {"type": ["string", "null"]},
            "discovery": {
              "type": "object",
              "properties": {"status": {"const": "runtimeOnly"}, "note": {"type": "string"}}
            }
          }
        },
        "hosting": {
          "type": "object",
          "required": ["kind", "endpoint"],
          "properties": {
            "kind": {"type": "string"},
            "endpoint": {"type": ["string", "null"]},
            "project": {"type": "string"},
            "agentId": {"type": "string"},
            "azure": {"type": "object"},
            "note": {"type": "string"}
          }
        },
        "upstream": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {"type": ["string", "null"]},
              "transport": {"enum": ["jsonRpc", "http"]},
              "path": {"type": ["string", "null"]},
              "source": {"enum": ["jsonRpcProperties", "backend", "serviceUrl"]}
            }
          }
        },
        "a2a": {
          "description": "The raw APIM properties, kept verbatim because this surface is in preview.",
          "type": "object"
        },
        "policyRefs": {"$ref": "#/$defs/policyRefs"},
        "access": {"type": "object"},
        "note": {"type": "string"}
      }
    },
    "policyRefs": {
      "type": "object",
      "properties": {
        "global": {"type": ["string", "null"]},
        "api": {"type": ["string", "null"]},
        "fragments": {"type": "array", "items": {"type": "string"}},
        "products": {"type": "array", "items": {"type": "string"}},
        "operations": {"type": "array", "items": {"type": "string"}},
        "operationPoliciesCollected": {
          "description": "False means an empty `operations` list says nothing about whether operation policies exist.",
          "type": "boolean"
        }
      }
    },
    "policyDocument": {
      "type": "object",
      "required": ["id", "scope", "elements", "stats"],
      "properties": {
        "id": {"type": "string"},
        "scope": {
          "type": "object",
          "required": ["level"],
          "properties": {
            "level": {"enum": ["global", "workspace", "product", "api", "operation", "fragment"]},
            "name": {"type": ["string", "null"]},
            "apiName": {"type": "string"},
            "workspace": {
              "description": "The workspace this scope belongs to, `default` for the implicit one. Declared because a name alone does not identify a scope: two workspaces can hold a fragment, a product or an API of the same name, and resolving an `include-fragment` against the wrong one applies a policy to traffic it never governed.",
              "type": "string"
            },
            "resourceId": {"type": ["string", "null"]}
          }
        },
        "format": {"const": "rawxml"},
        "xml": {"type": "string"},
        "parseError": {"type": ["string", "null"]},
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section", "path", "name", "family"],
            "properties": {
              "section": {"type": "string"},
              "path": {"type": "string"},
              "name": {"type": "string"},
              "family": {"type": "string"},
              "depth": {"type": "integer"},
              "attributes": {"type": "object"},
              "text": {"type": ["string", "null"]},
              "expressionIds": {"type": "array", "items": {"type": "string"}},
              "namedValueRefs": {"type": "array", "items": {"type": "string"}},
              "childNames": {"type": "array", "items": {"type": "string"}},
              "fragmentId": {"type": "string"}
            }
          }
        },
        "expressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sha256"],
            "properties": {
              "id": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "length": {"type": "integer"},
              "source": {"type": ["string", "null"]},
              "containsLiteralSecret": {"type": "boolean"},
              "references": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "namedValueRefs": {"type": "array", "items": {"type": "string"}},
        "fragmentRefs": {"type": "array", "items": {"type": "string"}},
        "secretRefs": {"type": "array", "items": {"type": "string"}},
        "redactions": {"type": "array"},
        "stats": {"type": "object"}
      }
    },
    "namedValue": {
      "type": "object",
      "required": ["id", "name", "secret"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "workspace": {"type": "string"},
        "displayName": {"type": ["string", "null"]},
        "secret": {"type": "boolean"},
        "tags": {"type": ["array", "null"]},
        "keyVault": {"type": ["object", "null"]},
        "value": {
          "description": "Present only for values APIM does not mark secret; a secret value is never written here.",
          "type": ["string", "null"]
        },
        "secretRef": {"type": ["string", "null"]}
      }
    },
    "secretRef": {
      "description": "A pointer to a credential plus the exact command that retrieves it at apply time. The value itself never appears in this document.",
      "type": "object",
      "required": ["id", "class", "storage", "description", "retrievable", "resolution"],
      "properties": {
        "id": {"type": "string", "pattern": "^secret:"},
        "class": {"type": "string"},
        "storage": {
          "enum": [
            "apimEncrypted",
            "apimPlaintext",
            "keyVault",
            "inlineLiteral",
            "apimCertificateStore",
            "apimManagedToken",
            "none"
          ]
        },
        "description": {"type": "string"},
        "owner": {"type": ["string", "null"]},
        "usedBy": {"type": "array", "items": {"type": "string"}},
        "retrievable": {"type": "boolean"},
        "resolution": {"oneOf": [{"$ref": "#/$defs/resolution"}, {"type": "null"}]},
        "alternateResolution": {"oneOf": [{"$ref": "#/$defs/resolution"}, {"type": "null"}]},
        "keyVault": {"type": "object"},
        "audience": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resolution": {
      "type": "object",
      "required": ["method", "request", "command", "valuePath", "permissions"],
      "properties": {
        "method": {"enum": ["armAction", "armRead", "armReadXml", "keyVault", "none"]},
        "request": {
          "type": ["object", "null"],
          "properties": {
            "httpMethod": {"enum": ["GET", "POST"]},
            "url": {"type": "string"},
            "body": {"type": ["object", "null"]}
          }
        },
        "command": {"type": ["string", "null"]},
        "valuePath": {"type": ["string", "null"]},
        "permissions": {"type": "array", "items": {"type": "string"}},
        "alsoReturns": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
